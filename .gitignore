# pyenv
#   For a library or package, you might want to ignore these files since the values are
#   specific to the developer's system. But for a application, you might want to commit
#   them so others can easily run your application with the same python version.
# .python-version

# pipenv
#   According to pypa/pipenv#1255, pipenv should generally not be committed
#   unless it is a top-level application. So we keep this ignored.
#Pipfile.lock

# poetry
#   Similarly, poetry.lock should be committed for applications but ignored for libraries.
#poetry.lock

# pdm
#   PDM local configuration
.pdm-python
.pdm-db/

